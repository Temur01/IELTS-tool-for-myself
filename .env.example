# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings -> API). These two are safe for the browser:
# the publishable key (sb_publishable_...) only works within your row-level security policies.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. Enables Merriam-Webster Collegiate Thesaurus lookups.
# Free for non-commercial use (1,000 queries/day per key). https://dictionaryapi.com/
MW_THESAURUS_API_KEY=

# Optional, server-only. Datamuse says keys become required in early 2027;
# leave empty until you receive one.
DATAMUSE_API_KEY=
